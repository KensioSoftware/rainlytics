{
  "name": "@kensio/rainlytics",
  "version": "0.3.0",
  "description": "Self-hosted web analytics for AWS sites, built on CloudFront logs",
  "repository": "https://github.com/KensioSoftware/rainlytics",
  "homepage": "https://rainlytics.com",
  "bugs": "https://github.com/KensioSoftware/rainlytics/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rainlytics": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist/cdk/index.d.ts",
      "import": "./dist/cdk/index.js"
    },
    "./beacon": {
      "types": "./dist/beacon/index.d.ts",
      "import": "./dist/beacon/index.js"
    },
    "./beacon/vitals": {
      "types": "./dist/beacon/vitals.d.ts",
      "import": "./dist/beacon/vitals.js"
    },
    "./beacon/errors": {
      "types": "./dist/beacon/errors.d.ts",
      "import": "./dist/beacon/errors.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "browserslist": [
    "baseline 2022"
  ],
  "imports": {
    "#test/*": "./test/*"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.lambda.json && cp src/cdk/beacon-204.cff.js dist/cdk/",
    "prepack": "pnpm build",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "fmt": "oxlint --fix . && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "lint:ci": "oxlint --format=github . && oxfmt --check .",
    "docs:check": "./scripts/sh/docs-check.sh",
    "fta": "./scripts/sh/fta.sh",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "pack:check": "./scripts/sh/pack-check.sh",
    "beacon:size": "node scripts/js/beacon-size.mjs",
    "check": "pnpm fmt && pnpm lint && pnpm docs:check && pnpm fta && pnpm build:check && pnpm pack:check && pnpm beacon:size && pnpm test:coverage"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.7.2"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1119.0",
    "@faker-js/faker": "^10.6.0",
    "@kensio/smartass": "^1.37.5",
    "@kensio/yulin": "^1.21.0",
    "@semantic-release/exec": "7.1.0",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.7.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "^0.28.2",
    "fta-cli": "^3.0.0",
    "happy-dom": "^20.11.15",
    "node-sql-parser": "^5.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "semantic-release": "25.0.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "analytics",
    "aws",
    "cloudfront",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Kensio Software",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1119.0"
  }
}
